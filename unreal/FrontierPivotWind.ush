// FrontierPivotWind.ush — pivot wind for Frontier trees (Unreal Engine 5).
//
// Paste into a Custom HLSL node (or a .ush include) and drive World Position
// Offset. No textures needed: every vertex already carries its branch pivot.
//
// Inputs (node pins -> mesh data):
//   Position      : object-space vertex position (Vertex Position)
//   Pivot         : branch pivot, object space. From extra UVs:
//                     PivotXY = TEXCOORD_2, PivotZ_Flutter = TEXCOORD_3
//                     (glTF TEXCOORD_1/2 import as UV channels 2/3 in UE)
//                     Pivot = float3(UV2.x, UV2.y, UV3.x), Flutter = UV3.y
//   Weight        : vertex color R (0 trunk .. 1 tips)
//   Phase         : vertex color G (per-branch random 0..1)
//   Flutter       : twig flutter amount (UV3.y)
//   Time          : game time (Time node)
//   WindStrength  : global multiplier (MPC, default ~0.6)
//   WindSpeed     : global speed multiplier (default 1.0)
//   WindDirection : object-space wind dir (default float3(0.8,0,0.6))
//
// Output: offset to ADD to the vertex position (World Position Offset pin
// expects world-space; object==world here up to the actor transform, which
// UE handles when "World Position Offset" is evaluated in the vertex shader).

float3 FrontierWindOffset(
    float3 Position, float3 Pivot, float Weight, float Phase, float Flutter,
    float Time, float WindStrength, float WindSpeed, float3 WindDirection)
{
    float3 off = Position - Pivot;
    float t = Time * WindSpeed;
    float gust = sin(t * 1.3 + Phase * 6.2831) * 0.65
               + sin(t * 2.9 + Phase * 12.566 + Pivot.x) * 0.25
               + sin(t * 5.1 + Phase * 3.0) * 0.10 * Flutter;
    float ang = gust * WindStrength * (0.10 + 0.55 * Weight);

    // rotate the branch offset around an axis perpendicular to the wind:
    // true pivot rotation, so limbs swing rigidly near the pivot and the
    // single fused mesh never cracks at the junctions.
    float3 ax = normalize(cross(float3(0, 1, 0), WindDirection) + float3(0, 0.35, 0));
    float c = cos(ang), s = sin(ang);
    float3 rot = off * c + cross(ax, off) * s + ax * dot(ax, off) * (1.0 - c);
    float3 p = Pivot + rot;

    // gentle trunk sway (whole-tree lean, weight-independent small term)
    p.xz += WindDirection.xz * (WindStrength * 0.05 * sin(t * 0.9) * (Position.y * 0.15));

    return p - Position;
}

// --- Minimal material graph (bark) ---------------------------------------
// VertexColor[R] -> Weight, VertexColor[G] -> Phase
// TexCoord[2]  -> Pivot.xy, TexCoord[3] -> (Pivot.z, Flutter)
// Time -> Time, MPC scalars -> WindStrength/WindSpeed, MPC vector -> WindDirection
// Custom(HLSL above) -> World Position Offset
// BaseColor: bark texture * VertexColor[B] (cavity AO), Roughness 0.95
//
// --- Leaves ----------------------------------------------------------------
// Same graph + TwoSided + Masked blend (alpha from leaf texture). Add extra
// normal-direction flutter: Normal * (Flutter * 0.02 * Wind * sin(t*9+...))
