[level]
format_version = 1
name = "Everest — Default Scene"

[[records]]
identity = "rec_diagnostics"
type = "Diagnostics"
name = "Diagnostics"
[records.configuration]
timing_overlay = true
memory_overlay = false

[[records]]
identity = "rec_clusters"
type = "PolygonClusters"
name = "Geometry clusters"
[records.configuration]
enabled = true
hierarchy_depth = 6
max_cluster_triangles = 128
hiz_culling = true

[[records]]
identity = "rec_pipeline"
type = "RenderPipeline"
name = "Render settings"
[records.configuration]
enabled = true
hardware_ray_query = true
quality_tier = 2
inspection_mode = 0
exposure_ev = 0.12
bloom_intensity = 0.26
global_illumination = true
temporal_aa = true

[[records]]
identity = "rec_sdf"
type = "DistanceField"
name = "BVH & distance field"
[records.configuration]
enabled = true
cascade0_m = 16.0
cascade1_m = 48.0
cascade2_m = 128.0
cascade3_m = 320.0
max_cone_steps = 48

[[records]]
identity = "rec_cards"
type = "SurfaceCards"
name = "Surface cache"
[records.configuration]
enabled = true
atlas_px = 1024
bounce_gain = 1.15
cards_per_object = 6

[[records]]
identity = "rec_solar"
type = "Solar"
name = "Sun"
[records.configuration]
enabled = true
elevation_deg = 38.0
azimuth_deg = 132.0
illuminance_klx = 98.0
kelvin = 5778.0

[[records]]
identity = "rec_flare"
type = "OpticalFlare"
name = "Lens Flare"
parent = "rec_solar"
[records.configuration]
enabled = true
intensity = 0.62
aperture_blades = 7

[[records]]
identity = "rec_clouds"
type = "Clouds"
name = "Clouds"
[records.configuration]
enabled = true
local_volume = false
coverage = 0.42
base_altitude_m = 1750.0
thickness_m = 1350.0

[[records]]
identity = "rec_local_cloud"
type = "Clouds"
name = "Local Cloud"
[records.configuration]
enabled = false
local_volume = true

[[records]]
identity = "rec_local_fog"
type = "Fog"
name = "Local Volumetric Fog"
[records.configuration]
enabled = false
local_volume = true

[[records]]
identity = "rec_atmosphere"
type = "Atmosphere"
name = "Atmosphere"
[records.configuration]
enabled = true
rayleigh = 1.0
mie_turbidity = 2.3
ozone = 1.0

[[records]]
identity = "rec_stars"
type = "Stars"
name = "Stars"
[records.configuration]
enabled = true
hipparcos_count = 5000
magnitude_gain = 1.15

[[records]]
identity = "rec_moons"
type = "Moons"
name = "Moons"
[records.configuration]
enabled = true
primary_phase = 0.68
secondary_enabled = true

[[records]]
identity = "rec_planet_venus"
type = "Planet"
name = "Venus"
[records.configuration]
enabled = true
body = 0
apparent_diameter_deg = 0.80
brightness = 1.0
ring_system = false
atmosphere_shell = true

[[records]]
identity = "rec_planet_jupiter"
type = "Planet"
name = "Jupiter"
[records.configuration]
enabled = true
body = 1
apparent_diameter_deg = 1.26
brightness = 1.0
ring_system = false
atmosphere_shell = false

[[records]]
identity = "rec_planet_mars"
type = "Planet"
name = "Mars"
[records.configuration]
enabled = true
body = 2
apparent_diameter_deg = 0.69
brightness = 1.0
ring_system = false
atmosphere_shell = false

[[records]]
identity = "rec_planet_saturn"
type = "Planet"
name = "Saturn"
[records.configuration]
enabled = true
body = 3
apparent_diameter_deg = 1.03
brightness = 1.0
ring_system = true
atmosphere_shell = false

[[records]]
identity = "rec_fog"
type = "Fog"
name = "Height Fog"
[records.configuration]
enabled = true
local_volume = false
base_density = 0.012
height_falloff = 0.14

[[records]]
identity = "rec_force_field"
type = "ForceField"
name = "Force Field"
[records.configuration]
enabled = true
visualize = false
include_turbulence = true
centre_metres = [-20.0, 0.0, 8.0]
half_extents_metres = [20.0, 20.0, 8.0]
grid_resolution = 5
arrow_seconds = 0.5

[[records]]
identity = "rec_wind"
type = "Wind"
name = "Wind"
parent = "rec_force_field"
[records.configuration]
enabled = true
direction_deg = 45.0
speed_mps = 6.5
turbulence = 0.45
