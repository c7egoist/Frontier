# =====================================================================
#  MuscleCar74 — low-poly blue fastback muscle car (reference #74)
#  Method: side silhouette -> extrude -> boolean-subtract wheel arches.
#    * The beltline stays above each arch top across the wheel footprint
#      so the full-width arch tunnels never sever the body (closed solid).
#    * All four wheel cutters are UNIONed into one cutter, then a single
#      boolean subtract carves both arches (robust in this kernel).
#    * Wheels sit concentrically inside the arches with clearance and do
#      NOT intersect the body (physics-friendly).
#  Run:  SolidArc --continue --proofs Proofs Cars/MuscleCar74.scr
# =====================================================================
workplane xz
# side silhouette: nose -> front haunch -> cowl -> windshield -> roof ->
#                  backlight -> rear haunch -> tail (front is low x)
polyline (0.10,0.30) (4.34,0.30) (4.46,0.50) (4.22,0.72) (3.72,0.90) (3.28,1.02) (2.90,0.94) (2.78,1.02) (2.30,1.32) (1.52,1.34) (1.12,0.94) (0.98,1.00) (0.55,0.90) (0.30,0.68) (0.10,0.46) --closed --name=Sil
extrude Sil 1.90 --direction=(0,1,0) --name=B0

# --- wheel arches: two full-width tunnels, unioned, single subtract ---
cylinder (0.98,-0.45,0.360) 0.43 2.80 --axis=(0,1,0) --name=AF
cylinder (3.28,-0.45,0.360) 0.42 2.80 --axis=(0,1,0) --name=AR
boolean union AF -- AR --name=Cutter
boolean subtract B0 -- Cutter --name=Body

# --- paint (System-B flake) + glass (windshield f11, backlight f9) ---
matcap Body plastic-blue
matcap Body glass --face=9,11

# --- tyres: rubber cylinders tucked into the arches (no intersection) ---
cylinder (0.98,-0.02,0.360) 0.35 0.30 --axis=(0,1,0) --name=WFL
cylinder (0.98,1.62,0.360) 0.35 0.30 --axis=(0,1,0) --name=WFR
cylinder (3.28,-0.02,0.360) 0.34 0.30 --axis=(0,1,0) --name=WRL
cylinder (3.28,1.62,0.360) 0.34 0.30 --axis=(0,1,0) --name=WRR
matcap WFL WFR WRL WRR rubber

# --- chrome hub caps, flush on the outer tyre faces ---
cylinder (0.98,-0.07,0.360) 0.17 0.06 --axis=(0,1,0) --name=HFL
cylinder (0.98,1.90,0.360) 0.17 0.06 --axis=(0,1,0) --name=HFR
cylinder (3.28,-0.07,0.360) 0.16 0.06 --axis=(0,1,0) --name=HRL
cylinder (3.28,1.90,0.360) 0.16 0.06 --axis=(0,1,0) --name=HRR
matcap HFL HFR HRL HRR chrome

# --- side (DLO) glass, flush outside the greenhouse ---
box (1.15,-0.015,0.98) (2.75,0.0,1.30) --name=GLL
box (1.15,1.90,0.98) (2.75,1.915,1.30) --name=GLR
matcap GLL GLR glass

# --- lights ---
box (0.03,0.22,0.55) (0.10,0.62,0.72) --name=HLA
box (0.03,1.28,0.55) (0.10,1.68,0.72) --name=HLB
matcap HLA HLB headlight
box (4.46,0.18,0.50) (4.52,1.72,0.68) --name=TL
matcap TL taillight

view iso
view fit
render muscle --size=1200x850
# default export keeps duplicated faces (sharp low-poly edges);
# add --weld to merge coincident vertices for smooth shading.
export Meshes/MuscleCar74.obj
