# ── Car A — low-poly muscle car (ref: blue Candylab #74) ──────────────────────
# X = length (nose at x=0), Y = width, Z = up. Ground at z=0.
# Body: long low slab, raked hood (front-top) + fastback deck (rear-top).
box (0,0,0.34) (4.6,1.98,1.02) --name=BodyRaw
chamfer BodyRaw 0.44 --edges=5,7 --name=Body
# Greenhouse: dark glass band, tapered front (windshield) + rear (fastback).
box (1.55,0.18,1.02) (3.15,1.80,1.46) --name=GlassRaw
chamfer GlassRaw 0.40 --edges=5,7 --name=Glass
# Painted roof cap sitting on the glass band.
box (2.00,0.30,1.46) (2.80,1.68,1.52) --name=Roof
# Wheels (fat), centre z = radius so they touch the ground.
cylinder (0.98,-0.06,0.44) 0.44 0.30 --axis=(0,1,0) --name=WheelFL
cylinder (0.98,1.74,0.44) 0.44 0.30 --axis=(0,1,0) --name=WheelFR
cylinder (3.62,-0.06,0.44) 0.44 0.30 --axis=(0,1,0) --name=WheelRL
cylinder (3.62,1.74,0.44) 0.44 0.30 --axis=(0,1,0) --name=WheelRR
# Chrome hub caps, just outboard of each wheel's outer face.
cylinder (0.98,-0.10,0.44) 0.15 0.05 --axis=(0,1,0) --name=HubFL
cylinder (0.98,2.04,0.44) 0.15 0.05 --axis=(0,1,0) --name=HubFR
cylinder (3.62,-0.10,0.44) 0.15 0.05 --axis=(0,1,0) --name=HubRL
cylinder (3.62,2.04,0.44) 0.15 0.05 --axis=(0,1,0) --name=HubRR
# Materials (preview studios)
matcap Body plastic-blue
matcap Glass carbon
matcap Roof pearl
matcap WheelFL carbon
matcap WheelFR carbon
matcap WheelRL carbon
matcap WheelRR carbon
matcap HubFL chrome
matcap HubFR chrome
matcap HubRL chrome
matcap HubRR chrome
view iso
view fit
render CarA_Muscle74 --size=760x560
