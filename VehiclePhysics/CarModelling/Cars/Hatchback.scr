# =====================================================================
#  Hatchback — low-poly red compact two-box hot hatch (reference: red hatch)
#  Same robust method: silhouette -> extrude -> unioned arch tunnels ->
#  single subtract. Short overhangs, steep tailgate, tall greenhouse over
#  the rear axle. Wheels sit inside the arches (no intersection).
#  Run:  SolidArc --continue --proofs Proofs Cars/Hatchback.scr
# =====================================================================
workplane xz
polyline (0.10,0.32) (3.50,0.32) (3.62,0.54) (3.50,0.94) (3.30,1.28) (2.95,1.40) (1.70,1.42) (1.20,1.00) (1.00,1.06) (0.60,0.96) (0.30,0.74) (0.10,0.52) --closed --name=Sil
extrude Sil 1.88 --direction=(0,1,0) --name=B0

cylinder (0.95,-0.45,0.360) 0.43 2.78 --axis=(0,1,0) --name=AF
cylinder (2.75,-0.45,0.360) 0.42 2.78 --axis=(0,1,0) --name=AR
boolean union AF -- AR --name=Cutter
boolean subtract B0 -- Cutter --name=Body

# paint (System-B flake, red) + glass (windshield f8, tailgate f6)
matcap Body plastic-red
matcap Body glass --face=6,8

cylinder (0.95,-0.02,0.360) 0.35 0.30 --axis=(0,1,0) --name=WFL
cylinder (0.95,1.60,0.360) 0.35 0.30 --axis=(0,1,0) --name=WFR
cylinder (2.75,-0.02,0.360) 0.34 0.30 --axis=(0,1,0) --name=WRL
cylinder (2.75,1.60,0.360) 0.34 0.30 --axis=(0,1,0) --name=WRR
matcap WFL WFR WRL WRR rubber

cylinder (0.95,-0.07,0.360) 0.17 0.06 --axis=(0,1,0) --name=HFL
cylinder (0.95,1.88,0.360) 0.17 0.06 --axis=(0,1,0) --name=HFR
cylinder (2.75,-0.07,0.360) 0.16 0.06 --axis=(0,1,0) --name=HRL
cylinder (2.75,1.88,0.360) 0.16 0.06 --axis=(0,1,0) --name=HRR
matcap HFL HFR HRL HRR chrome

box (1.25,-0.015,1.04) (2.85,0.0,1.36) --name=GLL
box (1.25,1.88,1.04) (2.85,1.895,1.36) --name=GLR
matcap GLL GLR glass

box (0.03,0.24,0.56) (0.10,0.66,0.76) --name=HLA
box (0.03,1.24,0.56) (0.10,1.66,0.76) --name=HLB
matcap HLA HLB headlight
box (3.62,0.20,0.82) (3.68,1.70,1.18) --name=TL
matcap TL taillight

view iso
view fit
render hatch --size=1200x850
export Meshes/Hatchback.obj
