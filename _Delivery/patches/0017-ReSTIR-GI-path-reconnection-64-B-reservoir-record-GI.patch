+// CPU mirror of IndirectPathReconnect: the receiver traces its OWN bounce along the two directions it is being
+//    offered, so the target is evaluated here rather than inherited from the neighbour. Mirrors RunGiInitial's
+//    chain term for term, which is the point — reconnection and initial candidates must score the same quantity.
+static IndirectPathStructure GiReconnect(const GB& g, const float3& dir, const float3& dir2,
+                                         const SkyConfiguration& p) noexcept
+{
+    IndirectPathStructure path;
+    const float3 nSky = normalize(g.normal);
+    const float3 origin = g.pos + g.normal * 1e-3f;
+    const float cosT = max(dot(nSky, dir), 0.0f);
+    path.throughput = g.albedo * (cosT / SkyPi);
+    float pdf = cosT / SkyPi;
+    const TraceHit h = TraceCorner(origin, dir, 1e-3f);
+    path.hit = h.hit;
+    if (h.hit)
+    {
+        const float3 n2 = h.normal;
+        const float3 p2 = origin + dir * h.t + n2 * 1e-3f;
+        const float cos2 = max(dot(n2, dir2), 0.0f);
+        path.throughput = path.throughput * g.albedo * (cos2 / SkyPi);
+        pdf = pdf * (cos2 / SkyPi);
+        const TraceHit h2 = TraceCorner(p2, dir2, 1e-3f);
+        path.le = h2.hit ? float3(0.0f, 0.0f, 0.0f) : SkyRadianceCompute(dir2, p);
+    }
+    else
+    {
+        path.le = SkyRadianceCompute(dir, p);
+    }
+    path.pdf = pdf;
+    return path;
+}
