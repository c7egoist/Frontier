+const char* SwapchainExchange::DescribePipeline(const DispatchConfiguration& Dispatch, std::string& Reason) const noexcept
+{
+    try
+    {
+        if ((Dispatch.FeatureFlags & DispatchFeatureRaytracing) == 0u)
+        {
+            const bool GlobalIllumination = (Dispatch.FeatureFlags & DispatchFeatureGlobalIllumination) != 0u;
+            if (GlobalIllumination && DistanceFieldStage.IsReady())
+            {
+                Reason = "ray tracing is off in the feature flags; distance-field GI is resident (hardware ray tracing is not used on this route)";
+                return "RasterSdfGi";
+            }
+            Reason = GlobalIllumination ? "ray tracing is off and the SDF stage is not ready; plain raster" : "ray tracing and global illumination are off; plain raster";
+            return "Raster";
+        }
+        if (QueryRayTracingTier() == RayTracingTierCategory::RayQuery)
+        {
+            Reason = "VK_KHR_ray_query pipeline and acceleration structure are resident; the RT cores trace";
+            return "HardwareRayQuery";
+        }
+        Reason = !HardwareRefusal.empty() ? HardwareRefusal
+               : !Vulkan->RayQueryEnabled ? "VK_KHR_ray_query device resources were never created"
+               : !Vulkan->RayQueryPipeline ? "the RayQueryViewport pipeline does not exist"
+               : "the acceleration structure is not resident (no scene uploaded yet, or ConstructScene refused)";
+        return "SoftwareBvh";
+    }
+    catch (...)
+    {
+        return "Unknown";
+    }
