+bool DistanceFieldStructure::Matches(const SceneStructure& Scene) const
+{
+    const auto& Rows = Scene.QueryInstances();
+    if (Facets.empty() || Rows.size() != Instances.size() || Scene.QueryVertices().size() != Vertices.size() ||
+        Scene.QueryIndices().size() != Indices.size() || Scene.QueryMaterials().QueryRecords().size() != Materials.size()) return false;
