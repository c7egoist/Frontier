{
  "name": "frontier-ocean",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontier Ocean: large-scale, particle-based real-time ocean simulation in WebGPU (no FFT) for GTX-class hardware, scalable to RTX.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:wgsl": "node tools/check-wgsl.mjs",
    "check": "npm run check:globals && npm run typecheck && npm run check:wgsl && npm run test",
    "gen:globals": "node tools/gen-globals.mjs",
    "check:globals": "node tools/gen-globals.mjs --check",
    "predev": "npm run check:globals"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wgsl_reflect": "^1.6.0"
  }
}
