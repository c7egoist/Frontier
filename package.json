{
  "name": "frontier-road-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build && node scripts/standalone.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "format": "prettier --write src scripts tests index.html README.md package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check src scripts tests index.html README.md package.json tsconfig.json vite.config.ts",
    "audit:design": "node --import tsx scripts/reference-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "earcut": "^3.0.2",
    "fflate": "^0.8.3",
    "lucide": "^0.468.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sparticuz/chromium": "^140.0.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
